{
  "name": "@astorm/office-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "astorm-office 四格式（docx/xlsx/pptx/pdf）高保真预览 Vue3 组件库，悬浮显示 CLI 路径卡片",
  "main": "./dist/office-viewer.js",
  "module": "./dist/office-viewer.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/office-viewer.js"
    },
    "./style.css": "./dist/office-viewer.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build && vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json && node scripts/rewrite-dts.mjs",
    "build:demo": "vite build --mode demo",
    "example": "vite -c examples/basic/vite.config.ts",
    "preview": "vite preview --port 4173 --outDir dist-demo",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node -e \"require('fs').writeFileSync('.test-out/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\" && node .test-out/tests/core.test.js"
  },
  "peerDependencies": {
    "vue": "^3.4.0",
    "echarts": "^6.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "echarts": "^6.0.0",
    "typescript": "~5.3.0",
    "vite": "^5.3.5",
    "vue": "^3.5.17",
    "vue-tsc": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    }
  }
}
