{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workbook",
  "type": "object",
  "required": [
    "sheets"
  ],
  "properties": {
    "meta": {
      "anyOf": [
        {
          "$ref": "#/definitions/Meta"
        },
        {
          "type": "null"
        }
      ]
    },
    "date1904": {
      "type": "boolean"
    },
    "styles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/StyleDef"
      }
    },
    "default_font": {
      "description": "Workbook default font (styles.xml `fonts[0]`); Calibri 11 when omitted.",
      "anyOf": [
        {
          "$ref": "#/definitions/Font"
        },
        {
          "type": "null"
        }
      ]
    },
    "active_tab": {
      "description": "Active sheet index (0-based) in the workbook view.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "named_ranges": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/NamedRange"
      }
    },
    "sheets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Sheet"
      }
    },
    "theme": {
      "description": "原样保留的 `xl/theme/theme1.xml`（形状/图表里的 `schemeClr` 依赖它）。",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "definitions": {
    "Meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "StyleDef": {
      "description": "A reusable cell style definition. Cells reference it by name (via [`super::CellStyleRef::Named`]) or embed it inline.",
      "type": "object",
      "properties": {
        "font": {
          "anyOf": [
            {
              "$ref": "#/definitions/Font"
            },
            {
              "type": "null"
            }
          ]
        },
        "fill": {
          "type": [
            "string",
            "null"
          ]
        },
        "border": {
          "anyOf": [
            {
              "$ref": "#/definitions/Border"
            },
            {
              "type": "null"
            }
          ]
        },
        "alignment": {
          "anyOf": [
            {
              "$ref": "#/definitions/Alignment"
            },
            {
              "type": "null"
            }
          ]
        },
        "number_format": {
          "type": [
            "string",
            "null"
          ]
        },
        "locked": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "Font": {
      "type": "object",
      "properties": {
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "strike": {
          "type": "boolean"
        },
        "underline": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Border": {
      "description": "Border sides. `all` is a shorthand expanded into the four sides during normalization.",
      "type": "object",
      "properties": {
        "all": {
          "type": [
            "string",
            "null"
          ]
        },
        "top": {
          "type": [
            "string",
            "null"
          ]
        },
        "bottom": {
          "type": [
            "string",
            "null"
          ]
        },
        "left": {
          "type": [
            "string",
            "null"
          ]
        },
        "right": {
          "type": [
            "string",
            "null"
          ]
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "diagonal": {
          "type": [
            "string",
            "null"
          ]
        },
        "diagonal_up": {
          "type": "boolean"
        },
        "diagonal_down": {
          "type": "boolean"
        },
        "diagonal_color": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Alignment": {
      "type": "object",
      "properties": {
        "horizontal": {
          "type": [
            "string",
            "null"
          ]
        },
        "vertical": {
          "type": [
            "string",
            "null"
          ]
        },
        "wrap_text": {
          "type": "boolean"
        },
        "indent": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "text_rotation": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        }
      }
    },
    "NamedRange": {
      "type": "object",
      "required": [
        "name",
        "ref"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      }
    },
    "Sheet": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "sheet_type": {
          "description": "工作表类型：`None`/worksheet 为普通表，`chart` 为图表工作表（chartsheet）。",
          "type": [
            "string",
            "null"
          ]
        },
        "raw_sheet": {
          "description": "图表工作表的原始部件 XML（原样回写）。",
          "allOf": [
            {
              "$ref": "#/definitions/RawXml"
            }
          ]
        },
        "raw_sheet_rels": {
          "description": "图表工作表的原始关系文件 XML（原样回写）。",
          "allOf": [
            {
              "$ref": "#/definitions/RawXml"
            }
          ]
        },
        "tab_color": {
          "type": [
            "string",
            "null"
          ]
        },
        "hidden": {
          "type": "boolean"
        },
        "freeze": {
          "type": [
            "string",
            "null"
          ]
        },
        "direction": {
          "type": [
            "string",
            "null"
          ]
        },
        "gridlines": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "headings": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "zoom": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "default_col_width": {
          "description": "Default column width (characters) from `<sheetFormatPr>`.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "default_row_height": {
          "description": "Default row height (points) from `<sheetFormatPr>`.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "base_col_width": {
          "description": "Base column width from `<sheetFormatPr>`.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "show_formulas": {
          "type": "boolean"
        },
        "tab_selected": {
          "type": "boolean"
        },
        "auto_filter": {
          "type": [
            "string",
            "null"
          ]
        },
        "filter_columns": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FilterColumn"
          }
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Column"
          }
        },
        "merges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "protect": {
          "type": "boolean"
        },
        "validations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DataValidation"
          }
        },
        "conditional_formats": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ConditionalFormat"
          }
        },
        "sparklines": {
          "description": "迷你图（sparkline）。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Sparkline"
          }
        },
        "pivot_tables": {
          "description": "透视表（创建用；读取到的透视表以不透明部件保留）。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/PivotTable"
          }
        },
        "slicers": {
          "description": "切片器（基于透视缓存字段；创建用）。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Slicer"
          }
        },
        "drawing_shapes": {
          "description": "结构化形状（创建用；读取到的形状以 `shapes` 原样保留）。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Shape"
          }
        },
        "sort": {
          "description": "排序状态（`sortState`）。",
          "anyOf": [
            {
              "$ref": "#/definitions/SortState"
            },
            {
              "type": "null"
            }
          ]
        },
        "ole_objects": {
          "description": "OLE 嵌入对象（创建用；读取到的以部件原样保留）。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/OleObject"
          }
        },
        "background": {
          "description": "工作表背景图（`<picture r:id>`），部件路径如 \"xl/media/image2.jpeg\"。",
          "type": [
            "string",
            "null"
          ]
        },
        "print": {
          "anyOf": [
            {
              "$ref": "#/definitions/PrintSettings"
            },
            {
              "type": "null"
            }
          ]
        },
        "print_area": {
          "description": "Print area range, e.g. \"A1:C20\".",
          "type": [
            "string",
            "null"
          ]
        },
        "print_title_rows": {
          "description": "Rows repeated at top when printing, e.g. \"1:1\".",
          "type": [
            "string",
            "null"
          ]
        },
        "print_title_cols": {
          "description": "Columns repeated at left when printing, e.g. \"A:A\".",
          "type": [
            "string",
            "null"
          ]
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Table"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Row"
          }
        },
        "charts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Chart"
          }
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Image"
          }
        },
        "shapes": {
          "description": "原样保留的绘图形状/连接线锚点（`sp`/`cxnSp` 的原始 XML），回写时按原样输出。",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vml_drawings": {
          "description": "保留的表单控件 VML 部件（按钮等），原样回写。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/RawXml"
          }
        }
      }
    },
    "RawXml": {
      "description": "原样保留的 XML 片段：正常序列化，但在相等性比较中被忽略， 以免影响「生成→解析」往返断言的字段对齐。",
      "type": [
        "string",
        "null"
      ]
    },
    "FilterColumn": {
      "description": "A single AutoFilter column criterion (value list or custom comparison).",
      "type": "object",
      "required": [
        "col_id"
      ],
      "properties": {
        "col_id": {
          "description": "0-based column index within the filter range.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operator": {
          "type": [
            "string",
            "null"
          ]
        },
        "criteria": {
          "type": [
            "string",
            "null"
          ]
        },
        "criteria2": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Column": {
      "type": "object",
      "properties": {
        "width": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "hidden": {
          "type": "boolean"
        },
        "outline_level": {
          "description": "Outline (grouping) level, 1..=7.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "minimum": 0.0
        },
        "collapsed": {
          "type": "boolean"
        },
        "style": {
          "description": "Column default style applied to cells lacking their own.",
          "anyOf": [
            {
              "$ref": "#/definitions/StyleDef"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "DataValidation": {
      "description": "Data validation rule (dropdown lists, number ranges, etc.).",
      "type": "object",
      "required": [
        "range",
        "type"
      ],
      "properties": {
        "range": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "operator": {
          "type": [
            "string",
            "null"
          ]
        },
        "formula1": {
          "type": [
            "string",
            "null"
          ]
        },
        "formula2": {
          "type": [
            "string",
            "null"
          ]
        },
        "values": {
          "description": "Inline list values (list type) — serialized as a quoted CSV formula.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allow_blank": {
          "type": "boolean"
        },
        "show_error": {
          "type": "boolean"
        },
        "error_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "error_message": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_message": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ConditionalFormat": {
      "description": "A conditional-formatting rule.",
      "type": "object",
      "required": [
        "range",
        "type"
      ],
      "properties": {
        "range": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "operator": {
          "type": [
            "string",
            "null"
          ]
        },
        "formulas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "colors": {
          "description": "colorScale colors (2 or 3).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "color": {
          "description": "dataBar color.",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "description": "containsText: the text to search for.",
          "type": [
            "string",
            "null"
          ]
        },
        "rank": {
          "description": "top10 rank.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "percent": {
          "type": "boolean"
        },
        "bottom": {
          "type": "boolean"
        },
        "icon_style": {
          "description": "iconSet style, e.g. \"3TrafficLights1\".",
          "type": [
            "string",
            "null"
          ]
        },
        "reverse_icons": {
          "type": "boolean"
        },
        "show_value": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "time_period": {
          "description": "timePeriod rule, e.g. \"today\", \"lastWeek\", \"thisMonth\".",
          "type": [
            "string",
            "null"
          ]
        },
        "above_average": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "equal_average": {
          "type": "boolean"
        },
        "std_dev": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "font": {
          "anyOf": [
            {
              "$ref": "#/definitions/Font"
            },
            {
              "type": "null"
            }
          ]
        },
        "fill": {
          "type": [
            "string",
            "null"
          ]
        },
        "stop_if_true": {
          "type": "boolean"
        }
      }
    },
    "Sparkline": {
      "description": "迷你图（sparkline）：在单个单元格内绘制一列数据的小图表。",
      "type": "object",
      "required": [
        "data_range",
        "location"
      ],
      "properties": {
        "type": {
          "description": "类型：line（默认）/ column / winloss（OOXML stacked）。",
          "type": [
            "string",
            "null"
          ]
        },
        "data_range": {
          "description": "数据源范围，如 \"A1:A10\"（可含跨表前缀）。",
          "type": "string"
        },
        "location": {
          "description": "目标单元格，如 \"B1\"。",
          "type": "string"
        },
        "color": {
          "description": "线条/柱颜色（6 位十六进制）。",
          "type": [
            "string",
            "null"
          ]
        },
        "show_high": {
          "description": "是否显示高点/低点/首点/末点/负点标记。",
          "type": "boolean"
        },
        "show_low": {
          "type": "boolean"
        },
        "show_first": {
          "type": "boolean"
        },
        "show_last": {
          "type": "boolean"
        },
        "show_negative": {
          "type": "boolean"
        }
      }
    },
    "PivotTable": {
      "description": "透视表定义（创建用）。",
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "数据源区域，可含表名，如 \"Sheet1!A1:D100\"。",
          "type": "string"
        },
        "position": {
          "description": "放置锚点单元格，如 \"F2\"。",
          "type": [
            "string",
            "null"
          ]
        },
        "style": {
          "type": [
            "string",
            "null"
          ]
        },
        "rows": {
          "description": "行字段（列名）。",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "columns": {
          "description": "列字段（列名）。",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "values": {
          "description": "值字段。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/PivotValue"
          }
        }
      }
    },
    "PivotValue": {
      "description": "透视表字段聚合。",
      "type": "object",
      "required": [
        "field"
      ],
      "properties": {
        "field": {
          "description": "源字段名（列名）。",
          "type": "string"
        },
        "function": {
          "description": "聚合函数：sum（默认）/ count / average / max / min。",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "显示名（默认 \"Sum of <field>\"）。",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Slicer": {
      "description": "切片器（slicer）：绑定到同表透视缓存里的某个字段。",
      "type": "object",
      "required": [
        "field"
      ],
      "properties": {
        "field": {
          "description": "透视缓存字段名（列名）。",
          "type": "string"
        },
        "pivot": {
          "description": "所绑定的透视表名（缺省用本表第一个）。",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "caption": {
          "type": [
            "string",
            "null"
          ]
        },
        "style": {
          "type": [
            "string",
            "null"
          ]
        },
        "column_count": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "row_height": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "anchor": {
          "description": "放置位置：\"B2\" 或 \"B2:F7\"。",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Shape": {
      "description": "结构化形状（创建用）。",
      "type": "object",
      "properties": {
        "geometry": {
          "description": "预设几何：rect/ellipse/roundRect/triangle/rightArrow/diamond 等（默认 rect）。",
          "type": [
            "string",
            "null"
          ]
        },
        "anchor": {
          "description": "锚点：\"B2:F7\"（区域）或 \"B2\"（单格，配合 size）。",
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "anyOf": [
            {
              "$ref": "#/definitions/Size"
            },
            {
              "type": "null"
            }
          ]
        },
        "offset": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "int64"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "fill": {
          "description": "纯色填充（6 位十六进制）。",
          "type": [
            "string",
            "null"
          ]
        },
